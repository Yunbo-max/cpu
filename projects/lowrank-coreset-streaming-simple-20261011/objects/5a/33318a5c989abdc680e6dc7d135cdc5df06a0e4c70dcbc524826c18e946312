 out['arms'].append({'name':arm['name'],'retained_nonempty_starts':len(starts)-1,'windows':500,'certified_10pct_count':sum(x['certifies_10pct'] for x in rows),'max_relative_radius':max(x['relative_radius'] for x in rows),'rows':rows})
