r=json.loads((ROOT/'results/moment_prefix_window_v1.json').read_text());norms={500:0.};c=Counter();moment=0
for t in range(499,-1,-1):
 x=int(stream[t]);v=c[x];moment+=(v+1)**3-v**3;c[x]+=1;norms[t]=moment**(1/3)
