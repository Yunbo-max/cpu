#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import math
import resource
import time
from pathlib import Path


def chan_pair_state(center: float, distinct: bool) -> tuple[int, float, float]:
    lo = float(center - 1.0)
    hi = float(center + 1.0)
    delta = hi - lo
    mean = lo + delta / 2.0
    m2 = delta * delta / 2.0
    if distinct:
        assert mean == center and m2 == 2.0
    else:
        assert lo == hi == center and m2 == 0.0
    return 2, mean, m2


def main() -> None:
    start_wall = time.perf_counter()
    start_cpu = time.process_time()
    source_path = Path("results/streaming_variance_offset_stability_v1.json")
    source_bytes = source_path.read_bytes()
    source = json.loads(source_bytes)
    failures = []
    if len(source["rows"]) != 54 * 2 * 5:
        failures.append("unexpected_row_count")
    index = {(r["exponent"], r["order"], r["method"]): r for r in source["rows"]}
    for exponent in range(54):
        center = float(2**exponent)
        distinct = float(center - 1.0) != float(center + 1.0)
        expected = 4096.0 if distinct else 0.0
        pair = chan_pair_state(center, distinct)
        # A balanced alternating tree first forms identical pair states; merging
        # equal means only adds M2, so 2048 pairs give the analytic expectation.
        analytic_balanced_alternating = pair[2] * 2048
        if analytic_balanced_alternating != expected:
            failures.append(f"analytic_truth_e{exponent}")
        row = index[(exponent, "alternating", "chan_balanced")]
        if row["estimate_m2"] != analytic_balanced_alternating:
            failures.append(f"chan_alternating_e{exponent}")
        for order in ("alternating", "blocked"):
            two_pass = index[(exponent, order, "centered_two_pass_fsum")]
            if two_pass["estimate_m2"] != expected:
                failures.append(f"two_pass_{order}_e{exponent}")
    recomputed_checks = {
        "raw_fails_no_later_than_e27_both_orders": all(
            min(
                (e for e in range(53) if not index[(e, order, "raw_uncentered")]["passes"]),
                default=999,
            )
            <= 27
            for order in ("alternating", "blocked")
        ),
        "chan_passes_through_e52": all(index[(e, o, "chan_balanced")]["passes"] for e in range(53) for o in ("alternating", "blocked")),
        "shifted_passes_through_e52": all(index[(e, o, "raw_shift_first")]["passes"] for e in range(53) for o in ("alternating", "blocked")),
        "two_pass_passes_through_e52": all(index[(e, o, "centered_two_pass_fsum")]["passes"] for e in range(53) for o in ("alternating", "blocked")),
        "all_methods_zero_at_e53": all(r["passes"] for r in source["rows"] if r["exponent"] == 53),
    }
    if recomputed_checks != source["prediction_checks"]:
        failures.append("prediction_check_mismatch")
    output = {
        "schema_version": 1,
        "source_sha256": hashlib.sha256(source_bytes).hexdigest(),
        "row_count": len(source["rows"]),
        "recomputed_prediction_checks": recomputed_checks,
        "failures": failures,
        "passed": not failures,
        "wall_seconds": time.perf_counter() - start_wall,
        "process_cpu_seconds": time.process_time() - start_cpu,
        "peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
    }
    path = Path("results/streaming_variance_offset_stability_audit_v1.json")
    path.write_text(json.dumps(output, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(output, sort_keys=True))
    if failures:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
