#!/usr/bin/env python3
"""Bounded source-guided baseline calibration on URL Day0 -> Day1."""

from __future__ import annotations

import json
import math
import os
import pathlib
import platform
import resource
import statistics
import time
from collections import Counter

import numpy as np


ROOT = pathlib.Path(__file__).resolve().parents[1]
DATA = ROOT / ".deps" / "url_dataset" / "prefix"
FILES = [("Day0", DATA / "Day0.svm"), ("Day1", DATA / "Day1.svm")]
OUTPUT = ROOT / "results" / "url_prefix_baseline_calibration_v1.json"
D = 3_231_961
ETA = 0.95
PHI = statistics.NormalDist().inv_cdf(ETA)
PSI = 1.0 + PHI * PHI / 2.0
XI = 1.0 + PHI * PHI


def current_rss_bytes() -> int:
    with open("/proc/self/statm", "r", encoding="ascii") as f:
        resident_pages = int(f.read().split()[1])
    return resident_pages * os.sysconf("SC_PAGE_SIZE")


def parse_line(raw: str) -> tuple[int, np.ndarray, np.ndarray]:
    fields = raw.split()
    if len(fields) < 2:
        raise ValueError("empty or featureless SVM-light row")
    y_float = float(fields[0])
    if y_float not in (-1.0, 1.0):
        raise ValueError(f"unexpected label {fields[0]}")
    indices = np.empty(len(fields) - 1, dtype=np.int64)
    values = np.empty(len(fields) - 1, dtype=np.float64)
    previous = 0
    for j, token in enumerate(fields[1:]):
        index_text, value_text = token.split(":", 1)
        index = int(index_text)
        value = float(value_text)
        if index <= previous:
            raise ValueError(f"indices not strictly increasing: {previous}, {index}")
        if index < 1 or index > D:
            raise ValueError(f"feature index out of published range: {index}")
        if not math.isfinite(value):
            raise ValueError("nonfinite feature value")
        indices[j] = index - 1
        values[j] = value
        previous = index
    return int(y_float), indices, values


def examples():
    for day, path in FILES:
        with path.open("r", encoding="ascii") as f:
            for line_number, raw in enumerate(f, 1):
                try:
                    y, indices, values = parse_line(raw)
                except Exception as exc:
                    raise ValueError(f"{day}:{line_number}: {exc}") from exc
                yield day, y, indices, values


def profile() -> dict[str, object]:
    day_counts: dict[str, Counter] = {day: Counter() for day, _ in FILES}
    nnz: list[int] = []
    max_index = 0
    min_value = math.inf
    max_value = -math.inf
    total_nnz = 0
    for day, y, indices, values in examples():
        day_counts[day][y] += 1
        n = int(indices.size)
        nnz.append(n)
        total_nnz += n
        max_index = max(max_index, int(indices[-1]) + 1)
        min_value = min(min_value, float(values.min()))
        max_value = max(max_value, float(values.max()))
    nnz_array = np.asarray(nnz, dtype=np.int64)
    return {
        "days": {
            day: {"negative": counts[-1], "positive": counts[1], "examples": counts[-1] + counts[1]}
            for day, counts in day_counts.items()
        },
        "examples": len(nnz),
        "total_nnz": total_nnz,
        "nnz_per_example": {
            "min": int(nnz_array.min()),
            "median": float(np.median(nnz_array)),
            "p95": float(np.quantile(nnz_array, 0.95)),
            "max": int(nnz_array.max()),
        },
        "max_feature_index": max_index,
        "feature_value_min": min_value,
        "feature_value_max": max_value,
        "invariants": {
            "labels_exactly_plus_minus_one": True,
            "indices_strictly_increasing": True,
            "indices_within_published_dimension": True,
            "values_finite": True,
        },
    }


def record_mistake(day_stats: dict[str, dict[str, int]], day: str, mistake: bool) -> None:
    day_stats[day]["examples"] += 1
    day_stats[day]["mistakes"] += int(mistake)


def finalize_day_stats(day_stats: dict[str, dict[str, int]]) -> dict[str, dict[str, float | int]]:
    return {
        day: {
            **stats,
            "mistake_rate": stats["mistakes"] / stats["examples"],
        }
        for day, stats in day_stats.items()
    }


def constant_negative(profile_result: dict[str, object]) -> dict[str, object]:
    days = profile_result["days"]
    day_stats = {
        day: {
            "examples": int(stats["examples"]),
            "mistakes": int(stats["positive"]),
            "mistake_rate": int(stats["positive"]) / int(stats["examples"]),
        }
        for day, stats in days.items()
    }
    total_examples = sum(int(v["examples"]) for v in day_stats.values())
    total_mistakes = sum(int(v["mistakes"]) for v in day_stats.values())
    return {
        "method": "constant_negative",
        "overall_mistakes": total_mistakes,
        "overall_mistake_rate": total_mistakes / total_examples,
        "days": day_stats,
        "updates": 0,
        "retained_array_bytes": 0,
        "wall_seconds": 0.0,
    }


def run_pa(average: bool) -> dict[str, object]:
    start = time.perf_counter()
    mu = np.zeros(D, dtype=np.float64)
    v = np.zeros(D, dtype=np.float64) if average else None
    day_stats = {day: {"examples": 0, "mistakes": 0} for day, _ in FILES}
    updates = 0
    max_rss = current_rss_bytes()
    for i, (day, y, indices, values) in enumerate(examples(), 1):
        score = float(np.dot(mu[indices], values))
        margin = y * score
        if average:
            prediction_score = float(np.dot(v[indices], values)) + i * score
            mistake = y * prediction_score <= 0.0
        else:
            mistake = margin <= 0.0
        record_mistake(day_stats, day, mistake)
        if margin < 1.0:
            norm_sq = float(np.dot(values, values))
            if norm_sq > 0.0:
                alpha = (1.0 - margin) / norm_sq
                delta = alpha * y * values
                mu[indices] += delta
                if average:
                    v[indices] -= i * delta
                updates += 1
        if i % 500 == 0:
            max_rss = max(max_rss, current_rss_bytes())
    if not np.isfinite(mu).all() or (average and not np.isfinite(v).all()):
        raise FloatingPointError("nonfinite PA state")
    max_rss = max(max_rss, current_rss_bytes())
    total_examples = sum(stats["examples"] for stats in day_stats.values())
    total_mistakes = sum(stats["mistakes"] for stats in day_stats.values())
    state_bytes = mu.nbytes + (v.nbytes if average else 0)
    return {
        "method": "pa_average" if average else "pa",
        "overall_mistakes": total_mistakes,
        "overall_mistake_rate": total_mistakes / total_examples,
        "days": finalize_day_stats(day_stats),
        "updates": updates,
        "retained_array_bytes": state_bytes,
        "sampled_max_rss_bytes": max_rss,
        "final_weight_l2": float(np.linalg.norm(mu)),
        "wall_seconds": time.perf_counter() - start,
    }


def run_diag_cw() -> dict[str, object]:
    start = time.perf_counter()
    mu = np.zeros(D, dtype=np.float64)
    sigma = np.ones(D, dtype=np.float64)
    day_stats = {day: {"examples": 0, "mistakes": 0} for day, _ in FILES}
    updates = 0
    max_rss = current_rss_bytes()
    for i, (day, y, indices, values) in enumerate(examples(), 1):
        sigma_x = sigma[indices] * values
        score = float(np.dot(mu[indices], values))
        margin = y * score
        variance = float(np.dot(values, sigma_x))
        mistake = margin <= 0.0
        record_mistake(day_stats, day, mistake)
        if variance <= 0.0 or not math.isfinite(variance):
            raise FloatingPointError(f"invalid predictive variance at example {i}: {variance}")
        if margin < PHI * math.sqrt(variance):
            radical = margin * margin * PHI**4 / 4.0 + variance * PHI * PHI * XI
            alpha = (-margin * PSI + math.sqrt(radical)) / (variance * XI)
            sqrt_u = (-alpha * variance * PHI + math.sqrt(alpha * alpha * variance * variance * PHI * PHI + 4.0 * variance)) / 2.0
            beta = (alpha * PHI) / (sqrt_u + variance * alpha * PHI)
            if not all(math.isfinite(x) for x in (alpha, sqrt_u, beta)):
                raise FloatingPointError(f"nonfinite CW scalar at example {i}")
            mu[indices] += alpha * y * sigma_x
            sigma[indices] -= beta * sigma_x * sigma_x
            updates += 1
        if i % 500 == 0:
            max_rss = max(max_rss, current_rss_bytes())
    if not np.isfinite(mu).all() or not np.isfinite(sigma).all():
        raise FloatingPointError("nonfinite diagonal CW state")
    if float(sigma.min()) <= 0.0:
        raise FloatingPointError("nonpositive diagonal CW covariance")
    max_rss = max(max_rss, current_rss_bytes())
    total_examples = sum(stats["examples"] for stats in day_stats.values())
    total_mistakes = sum(stats["mistakes"] for stats in day_stats.values())
    return {
        "method": "cw_diag_l2",
        "eta": ETA,
        "phi": PHI,
        "overall_mistakes": total_mistakes,
        "overall_mistake_rate": total_mistakes / total_examples,
        "days": finalize_day_stats(day_stats),
        "updates": updates,
        "retained_array_bytes": mu.nbytes + sigma.nbytes,
        "sampled_max_rss_bytes": max_rss,
        "final_weight_l2": float(np.linalg.norm(mu)),
        "final_sigma_min": float(sigma.min()),
        "final_sigma_max": float(sigma.max()),
        "wall_seconds": time.perf_counter() - start,
    }


def main() -> None:
    total_start = time.perf_counter()
    prof = profile()
    methods = [constant_negative(prof), run_pa(False), run_pa(True), run_diag_cw()]
    learned = methods[1:]
    constant_day1 = methods[0]["days"]["Day1"]["mistake_rate"]
    best_day1 = min(method["days"]["Day1"]["mistake_rate"] for method in learned)
    total_wall = time.perf_counter() - total_start
    result = {
        "schema_version": 1,
        "experiment": "url_prefix_baseline_calibration_v1",
        "scope": "All examples in official Day0 then Day1; bounded diagnostic, not the published 20-day sampled protocol.",
        "published_dimension": D,
        "dtype": "float64",
        "author_alignment": {
            "mistake_rule": "y * prediction_score <= 0",
            "pa_update": "margin < 1; alpha=(1-margin)/||x||^2",
            "cw_variant": "diag_l2, stdev, eta=0.95, a=1",
        },
        "parser_profile": prof,
        "methods": methods,
        "gates": {
            "parser_invariants_pass": all(prof["invariants"].values()),
            "all_methods_finite": True,
            "best_day1_absolute_improvement_over_constant_negative": constant_day1 - best_day1,
            "signal_gate_at_least_0_01": constant_day1 - best_day1 >= 0.01,
            "wall_gate_at_most_300_seconds": total_wall <= 300.0,
            "max_retained_array_bytes": max(method["retained_array_bytes"] for method in methods),
            "process_limit_bytes": 4 * 1024**3,
        },
        "total_wall_seconds": total_wall,
        "process_peak_rss_bytes": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024,
        "environment": {
            "python": platform.python_version(),
            "numpy": np.__version__,
            "platform": platform.platform(),
            "thread_env": {name: os.environ.get(name) for name in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS")},
        },
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    temp = OUTPUT.with_suffix(OUTPUT.suffix + ".part")
    temp.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temp, OUTPUT)
    print(json.dumps({"total_wall_seconds": total_wall, "process_peak_rss_bytes": result["process_peak_rss_bytes"], "gates": result["gates"], "methods": [{"method": m["method"], "day1_mistake_rate": m["days"]["Day1"]["mistake_rate"], "wall_seconds": m["wall_seconds"]} for m in methods]}, sort_keys=True))


if __name__ == "__main__":
    main()
