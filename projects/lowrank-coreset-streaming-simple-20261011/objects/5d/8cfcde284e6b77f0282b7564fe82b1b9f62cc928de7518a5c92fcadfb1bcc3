#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RESULTS = ROOT / "results"


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> None:
    summary_path = RESULTS / "nystrom_native_diagnostic_v3.json"
    rows_path = RESULTS / "nystrom_native_diagnostic_v3_rows.json"
    summary = json.loads(summary_path.read_text())
    rows = json.loads(rows_path.read_text())

    flags = []
    reversals = []
    for case in rows["projection_cases"]:
        if case["case"] == "ordinary" and case["native_vs_mp_rel_fro"] > 1e-9:
            flags.append("ordinary_projection_mismatch")
        if (
            case["native_vs_mp_rel_fro"] > 1e-6
            or case["native_mp_score_max_abs"] > 1e-8
            or case["native_mp_pair_reversals"] > 0
        ):
            flags.append("singular_boundary:" + str(case["eps"]))
        reversals.append({
            "case": case["case"],
            "eps": case["eps"],
            "count": case["native_mp_pair_reversals"],
            "denominator": case["native_mp_pair_denominator"],
            "rate": case["native_mp_pair_reversals"] / case["native_mp_pair_denominator"],
        })

    z_max_error = 0.0
    overlap_rows = []
    for row in rows["rng_overlap"]["rows"]:
        recomputed_z = (row["mean_overlap"] - row["expected_mean"]) / row["analytic_mean_se"]
        z_error = abs(recomputed_z - row["z_from_expected"])
        z_max_error = max(z_max_error, z_error)
        overlap_rows.append({
            "row": row["row"],
            "recomputed_z": recomputed_z,
            "stored_z": row["z_from_expected"],
            "abs_error": z_error,
        })
        if row["row"].startswith("coupled_retained") and (
            abs(recomputed_z) > 4
            or abs(row["mean_overlap"] - row["expected_mean"]) > 0.1
        ):
            flags.append("retained_rng_overlap:" + row["row"])

    if not rows["decision_trace"]["match"]:
        flags.append("decision_trace_mismatch")
    flags = sorted(set(flags))
    checks = {
        "case_count": len(rows["projection_cases"]) == summary["case_count"],
        "flags": flags == summary["flags"],
        "ordinary_pass": (not any(f.startswith("ordinary_") for f in flags)) == summary["ordinary_pass"],
        "decision_trace_pass": bool(rows["decision_trace"]["match"]) == summary["decision_trace_pass"],
        "source_commit": rows["source_commit"] == summary["source_commit"],
        "z_arithmetic": z_max_error <= 1e-12,
    }
    audit = {
        "schema_version": 1,
        "input_sha256": {
            summary_path.name: sha256(summary_path),
            rows_path.name: sha256(rows_path),
        },
        "checks": checks,
        "all_checks_pass": all(checks.values()),
        "recomputed_flags": flags,
        "reversal_rates": reversals,
        "overlap_z_audit": overlap_rows,
        "max_overlap_z_abs_error": z_max_error,
    }
    out = RESULTS / "nystrom_native_diagnostic_v3_audit.json"
    out.write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n")
    if not audit["all_checks_pass"]:
        raise SystemExit("audit checks failed")
    print(json.dumps(audit, sort_keys=True))


if __name__ == "__main__":
    main()
