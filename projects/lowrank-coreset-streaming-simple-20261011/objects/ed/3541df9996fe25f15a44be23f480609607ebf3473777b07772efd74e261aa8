#!/usr/bin/env python3
from __future__ import annotations

import json
from math import sqrt
from pathlib import Path
import numpy as np

ROOT = Path(__file__).resolve().parents[1]
B = 199
WIDTHS = (28, 56, 140)
RHO2S = (0.54, 0.57, 0.60)
TRIALS = 24
MASTER_SEED = 2026101210
BOOTSTRAP_REPS = 5000

def reject(scores: list[float]) -> bool:
    a = np.asarray(scores)
    return bool((1 + np.count_nonzero(a[1:] >= a[0])) / (B + 1) <= 0.05)

def wilson(s: int, n: int) -> list[float]:
    z = 1.959963984540054
    p = s / n; den = 1 + z * z / n
    c = (p + z * z / (2 * n)) / den
    h = z * sqrt((p * (1 - p) + z * z / (4 * n)) / n) / den
    return [max(0.0, c - h), min(1.0, c + h)]

def boot(diff: np.ndarray, seed: int) -> list[float]:
    rng = np.random.default_rng(seed)
    out = np.asarray([np.mean(diff[rng.integers(0, len(diff), len(diff))]) for _ in range(BOOTSTRAP_REPS)])
    return [float(np.quantile(out, 0.025)), float(np.quantile(out, 0.975))]

def close(a, b, tol=1e-14):
    if not np.allclose(a, b, rtol=tol, atol=tol):
        raise AssertionError(f"mismatch: {a} != {b}")

def main() -> None:
    rows = json.loads((ROOT / "results/paper_scale_decision_v1_rows.json").read_text())
    summary = json.loads((ROOT / "results/paper_scale_decision_v1.json").read_text())
    assert len(rows) == 648 == summary["rows"]
    methods = {"nystrom_coordinate", "rff_coordinate", "rff_released_axis"}
    keyed = {(r["rho2"], r["trial"], r["ell"], r["method"]): r for r in rows}
    assert len(keyed) == len(rows)
    for rho in RHO2S:
        for trial in range(TRIALS):
            baseline_exact = None
            rff_seeds = set()
            for ell in WIDTHS:
                for method in methods:
                    r = keyed[(rho, trial, ell, method)]
                    assert len(r["scores"]) == B + 1 and len(r["exact_scores"]) == B + 1
                    assert r["reject"] == reject(r["scores"])
                    assert r["exact_reject"] == reject(r["exact_scores"])
                    assert r["decision_disagreement"] == (r["reject"] != r["exact_reject"])
                    if baseline_exact is None:
                        baseline_exact = r["exact_scores"]
                    else:
                        close(r["exact_scores"], baseline_exact, tol=0.0)
                    if method.startswith("rff_"):
                        rff_seeds.add(r["feature_seed"])
                        expected = ell // 2 if method == "rff_coordinate" else ell
                        assert r["native_parameter"] == expected and r["realized_width"] == 2 * expected
                        assert r["transform_state_bytes"] == 8 * expected * 3
                    else:
                        assert r["native_parameter"] == ell and r["realized_width"] == ell
                        assert r["transform_state_bytes"] == 8 * (ell * 3 + ell * ell)
            assert len(rff_seeds) == 1

    recomputed = {}
    for ell in WIDTHS:
        recomputed[str(ell)] = {}
        for method in sorted(methods):
            ss = [r for r in rows if r["ell"] == ell and r["method"] == method]
            assert len(ss) == 72
            rej = sum(r["reject"] for r in ss); dis = sum(r["decision_disagreement"] for r in ss)
            got = summary["groups"][str(ell)][method]
            assert got["rejections"] == rej and got["decision_disagreements"] == dis
            close(got["rejection_rate_wilson95"], wilson(rej, len(ss)))
            close(got["decision_disagreement_wilson95"], wilson(dis, len(ss)))
            close(got["median_original_abs_error"], float(np.median([r["original_abs_error"] for r in ss])))
            recomputed[str(ell)][method] = {"rejections": rej, "decision_disagreements": dis}
        rc_rr, ny_rc = [], []
        for rho in RHO2S:
            for trial in range(TRIALS):
                rc = keyed[(rho, trial, ell, "rff_coordinate")]["decision_disagreement"]
                rr = keyed[(rho, trial, ell, "rff_released_axis")]["decision_disagreement"]
                ny = keyed[(rho, trial, ell, "nystrom_coordinate")]["decision_disagreement"]
                rc_rr.append(int(rc) - int(rr)); ny_rc.append(int(ny) - int(rc))
        rc_rr = np.asarray(rc_rr); ny_rc = np.asarray(ny_rc)
        got = summary["groups"][str(ell)]["paired_contrasts"]
        close(got["rff_coordinate_minus_released_disagreement"], rc_rr.mean())
        close(got["rff_coordinate_minus_released_bootstrap95"], boot(rc_rr, MASTER_SEED + ell))
        close(got["nystrom_minus_rff_coordinate_disagreement"], ny_rc.mean())
        close(got["nystrom_minus_rff_coordinate_bootstrap95"], boot(ny_rc, MASTER_SEED + 1000 + ell))

    for rho in RHO2S:
        exact = {trial: keyed[(rho, trial, WIDTHS[0], "nystrom_coordinate")]["exact_reject"] for trial in range(TRIALS)}
        s = sum(exact.values()); got = summary["exact_by_rho"][str(rho)]
        assert got["n"] == TRIALS and got["rejections"] == s
        close(got["wilson95"], wilson(s, TRIALS))

    audit = {
        "schema": "paper-scale-decision-v1-independent-row-audit",
        "passed": True,
        "rows_checked": len(rows),
        "independent_trials": len(RHO2S) * TRIALS,
        "checks": ["row/key inventory", "shared exact scores", "decision recomputation", "state-byte formulas", "RFF shared seed", "Wilson intervals", "paired bootstrap intervals", "aggregate counts"],
        "recomputed_counts": recomputed,
        "limitation": "This audit independently recomputes retained rows and aggregates; it inspects but does not independently reimplement the native feature maps.",
    }
    (ROOT / "results/paper_scale_decision_v1_audit.json").write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n")
    print(json.dumps(audit, sort_keys=True))

if __name__ == "__main__":
    main()
