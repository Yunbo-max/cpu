#!/usr/bin/env python3
"""Fetch protocol pages only; do not fetch the 20 Newsgroups archive."""

from __future__ import annotations

import hashlib
import json
import pathlib
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone


ROOT = pathlib.Path(__file__).resolve().parents[1]
OUT = ROOT / "sources" / "20newsgroups-protocol-v1"
MANIFEST = ROOT / "sources" / "20newsgroups_protocol_manifest_v1.json"
SOURCES = [
    (
        "original_home.html",
        "https://qwone.com/~jason/20Newsgroups/",
        "original maintainer page",
    ),
    (
        "sklearn_loader.html",
        "https://scikit-learn.org/stable/modules/generated/sklearn.datasets.fetch_20newsgroups.html",
        "official loader API",
    ),
    (
        "sklearn_sparse_example.html",
        "https://scikit-learn.org/stable/auto_examples/text/plot_document_classification_20newsgroups.html",
        "official sparse classification example",
    ),
    (
        "sklearn_dataset_guide.html",
        "https://scikit-learn.org/stable/datasets/real_world.html#the-20-newsgroups-text-dataset",
        "official dataset guide",
    ),
]


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def main() -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    rows = []
    for filename, url, role in SOURCES:
        started = time.perf_counter()
        row = {"filename": filename, "url": url, "role": role}
        request = urllib.request.Request(
            url,
            headers={"User-Agent": "lowrank-coreset-streaming-source-audit/1.0"},
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                payload = response.read()
                row.update(
                    {
                        "ok": True,
                        "http_status": getattr(response, "status", None),
                        "final_url": response.geturl(),
                        "bytes": len(payload),
                        "sha256": hashlib.sha256(payload).hexdigest(),
                        "content_type": response.headers.get("Content-Type"),
                    }
                )
                (OUT / filename).write_bytes(payload)
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            row.update(
                {
                    "ok": False,
                    "error_type": type(exc).__name__,
                    "error": str(exc),
                }
            )
        row["elapsed_seconds"] = time.perf_counter() - started
        row["retrieved_at_utc"] = now()
        rows.append(row)

    manifest = {
        "schema_version": 1,
        "created_at_utc": now(),
        "scope": "protocol pages only; dataset archive was not requested",
        "sources": rows,
        "all_succeeded": all(row["ok"] for row in rows),
    }
    MANIFEST.parent.mkdir(parents=True, exist_ok=True)
    MANIFEST.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(json.dumps(manifest, sort_keys=True))


if __name__ == "__main__":
    main()
