#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import resource
from pathlib import Path

import numpy as np
from scipy.io import mmread


ROOT = Path(__file__).resolve().parents[1]
SUMMARY = ROOT / "results" / "fd_merge_topology_calibration_v1.json"
SKETCHES = ROOT / "results" / "fd_merge_topology_calibration_v1_sketches.npz"
SOURCE = ROOT.parent / "w002" / "sources" / "consistent-LRA" / "landmark.mtx"
K = 25


def close(a: float, b: float, scale: float) -> bool:
    return abs(a - b) <= 2e-9 * max(scale, 1.0)


def main() -> None:
    recorded = json.loads(SUMMARY.read_text(encoding="utf-8"))
    source_hash = hashlib.sha256(SOURCE.read_bytes()).hexdigest()
    assert source_hash == recorded["source"]["sha256"]
    a_source = np.asarray(mmread(SOURCE).tocsr()[:512].toarray(), dtype=np.float64)
    with np.load(SKETCHES, allow_pickle=False) as raw:
        a = np.asarray(raw["dense_prefix"])
        assert np.array_equal(a, a_source)
        dense_hash = hashlib.sha256(a.tobytes(order="C")).hexdigest()
        assert dense_hash == recorded["source"]["dense_prefix_sha256"]
        _, singular, vt = np.linalg.svd(a, full_matrices=False)
        optimum = float(np.sum(singular[K:] ** 2))
        assert close(optimum, recorded["exact"]["optimum_rank25_frobenius_cost"], optimum)
        rank_tol = np.finfo(np.float64).eps * max(a.shape) * singular[0]
        rank = int(np.sum(singular > rank_tol))
        basis = vt[:rank].T
        scale = float(np.sum(a * a))
        rows = []
        for arm in recorded["arms"]:
            ell = int(arm["ell"])
            method = arm["method"]
            sketch = np.asarray(raw[f"ell{ell}_{method}"])
            assert sketch.shape == (ell, a.shape[1])
            assert np.isfinite(sketch).all()
            _, _, sketch_vt = np.linalg.svd(sketch, full_matrices=False)
            projected = a @ sketch_vt[:K].T
            projection = float(scale - np.sum(projected * projected))
            aq = a @ basis
            bq = sketch @ basis
            loss = aq.T @ aq - bq.T @ bq
            eigenvalues = np.linalg.eigvalsh((loss + loss.T) * 0.5)
            covariance = float(max(eigenvalues[-1], 0.0))
            discarded = float((scale - np.sum(sketch * sketch)) / ell)
            assert close(projection, arm["projection_cost"], scale)
            assert close(covariance, arm["covariance_error"], scale)
            assert close(discarded, arm["discarded_mass_from_norm"], scale)
            assert close(discarded, arm["accumulated_discarded_mass"], scale)
            tolerance = 1e-8 * max(scale, 1.0)
            assert eigenvalues[0] >= -tolerance
            assert covariance <= optimum / (ell - K) + tolerance
            assert projection <= (1.0 + K / (ell - K)) * optimum + tolerance
            rows.append(
                {
                    "ell": ell,
                    "method": method,
                    "projection_cost": projection,
                    "discarded_mass": discarded,
                    "covariance_error": covariance,
                }
            )

    by_key = {(row["ell"], row["method"]): row for row in rows}
    comparisons = []
    all_widths_pass = True
    for ell in sorted({row["ell"] for row in rows}):
        balanced = by_key[(ell, "balanced")]
        left = by_key[(ell, "left_deep")]
        mass_difference = balanced["discarded_mass"] - left["discarded_mass"]
        projection_difference = balanced["projection_cost"] - left["projection_cost"]
        tolerance = 2e-9 * max(scale, 1.0)
        width_pass = mass_difference <= tolerance and projection_difference <= tolerance
        all_widths_pass = all_widths_pass and width_pass
        comparisons.append(
            {
                "ell": ell,
                "balanced_minus_left_deep_discarded_mass": mass_difference,
                "balanced_minus_left_deep_projection_cost": projection_difference,
                "hypothesis_pass": width_pass,
            }
        )

    audit = {
        "summary_sha256": hashlib.sha256(SUMMARY.read_bytes()).hexdigest(),
        "sketches_sha256": hashlib.sha256(SKETCHES.read_bytes()).hexdigest(),
        "source_sha256": source_hash,
        "rows_recomputed": len(rows),
        "all_metric_and_bound_checks_pass": True,
        "comparisons": comparisons,
        "prospective_all_widths_hypothesis_pass": all_widths_pass,
        "peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
    }
    target = ROOT / "results" / "fd_merge_topology_calibration_v1_audit.json"
    target.write_text(json.dumps(audit, indent=2, allow_nan=False), encoding="utf-8")
    print(json.dumps(audit))


if __name__ == "__main__":
    main()
