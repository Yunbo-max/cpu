from collections import Counter, deque
import hashlib,json,os,resource,sys,time
from pathlib import Path
os.environ['MPLBACKEND']='Agg'
ROOT=Path(__file__).resolve().parents[1]; SRC=ROOT/'sources/moments'
sys.path.insert(0,str(SRC))
import numpy as np
from moment_native_pilot import convert

def deep(obj,seen=None):
    if seen is None: seen=set()
    if id(obj) in seen:return 0
    seen.add(id(obj)); size=sys.getsizeof(obj)
    if isinstance(obj,dict):size+=sum(deep(k,seen)+deep(v,seen) for k,v in obj.items())
    elif isinstance(obj,(list,tuple,deque)):size+=sum(deep(x,seen) for x in obj)
    return size

def truth(x):return sum(int(v)**3 for v in Counter(map(int,x)).values())**(1/3)
def ref(path):return hashlib.sha256((ROOT/path).read_bytes()).hexdigest()

def main():
    start=time.perf_counter();out={'error':None,'arms':[],'exact':[]}
    try:
        data=np.load(ROOT/'data/moment_native_shift_1000.npy');prefix=data[:500];stream=data[500:]
        cs=json.loads((SRC/'CS.ipynb').read_text());ns={}
        exec(compile(''.join(cs['cells'][1]['source']),'CS.ipynb:cell1','exec'),ns)
        t=time.perf_counter();heavy=ns['count_sketch'](prefix,5,100,300,.1)
        out['advice']={'heavy':heavy,'train_wall_seconds':time.perf_counter()-t,'train_range':[0,500],'test_range':[500,1000],'numeric_counter_bytes':(5*300+5)*8,'prefix_counts':dict(Counter(map(int,prefix)))}
        Ws=[1,2,3,8,16,32,64,128,256,500]
        nb=json.loads((SRC/'SS-SSA.ipynb').read_text())
        for name,advice in [('prefix_cs',heavy),('native_hardcoded',[1,2,3])]:
            ns={}
            for i in [7,8,9,10,14]:exec(compile(''.join(nb['cells'][i]['source']),f'SS-SSA.ipynb:cell{i}','exec'),ns)
            ns.update(hist_ssa={},hist_ss={},hist_hh_sums={},threads_vec_ssa=[],num_threads_max=20)
            t=time.perf_counter();cpu=time.process_time()
            ns['selective_subsampling_augmented'](advice,stream,3,3,5,.01,.1)
            arm={'name':name,'advice':advice,'joint_wall_seconds':time.perf_counter()-t,'joint_cpu_seconds':time.process_time()-cpu,'suffixes':[],'queries':[]}
            starts=list(ns['hist_ssa'])
            for s in starts:
                arm['suffixes'].append({'start':s,'W':500-s,'truth_l3':truth(stream[s:]),'ssa':float(ns['estimate_norm'](s,3,3,5,.01)),'ss':float(ns['norm_helper'](s,3,3,5,.1))})
            for W in Ws:
                target=500-W;s=min(starts,key=lambda x:abs(x-target));row=next(x for x in arm['suffixes'] if x['start']==s)
                true=truth(stream[-W:]);represented=row['truth_l3']
                arm['queries'].append({'W':W,'target_start':target,'selected_start':s,'represented_W':500-s,'earlier_start':max((x for x in starts if x<=target),default=None),'later_start':min((x for x in starts if x>=target),default=None),'truth_l3':true,'represented_truth_l3':represented,'window_relative_error':(represented-true)/true,'ssa_relative_error':(row['ssa']-true)/true,'ssa_estimation_component':(row['ssa']-represented)/true,'ss_relative_error':(row['ss']-true)/true})
            arm['ssa_deep_bytes_final']=deep([ns['hist_ssa'],ns['hist_hh_sums'],starts,advice]);arm['ss_deep_bytes_final']=deep([ns['hist_ss'],starts])
            arm['retained_state']={k:ns[k] for k in ['hist_ssa','hist_ss','hist_hh_sums','threads_vec_ssa']}
            out['arms'].append(arm)
        for W in Ws:
            q=deque();counts=Counter();F3=0;alg=0.;checks=0.;peak=0
            for i,x in enumerate(map(int,stream)):
                t=time.perf_counter();old=counts[x];F3+=(old+1)**3-old**3;counts[x]+=1;q.append(x)
                if len(q)>W:
                    y=q.popleft();old=counts[y];F3+=(old-1)**3-old**3;counts[y]-=1
                    if counts[y]==0:del counts[y]
                estimate=F3**(1/3);alg+=time.perf_counter()-t
                t=time.perf_counter();expected=sum(v**3 for v in Counter(map(int,stream[max(0,i+1-W):i+1])).values());assert F3==expected
                peak=max(peak,deep([q,counts,F3]));checks+=time.perf_counter()-t
            out['exact'].append({'W':W,'arrivals':len(stream),'all_arrivals_correct':True,'F3':F3,'l3':estimate,'algorithm_seconds':alg,'validation_and_memory_accounting_seconds':checks,'peak_deep_bytes':peak})
        out['inputs_sha256']={p:ref(p) for p in ['data/moment_native_shift_1000.npy','sources/moments/CS.ipynb','sources/moments/SS-SSA.ipynb','sources/moments/utils.py']}
    except Exception as exc:out['error']=repr(exc);raise
    finally:
        out['total_seconds']=time.perf_counter()-start;out['peak_rss_kib']=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        (ROOT/'results/moment_prefix_window_v1.json').write_text(json.dumps(convert(out),indent=2,allow_nan=False));print(json.dumps({k:out[k] for k in ['error','total_seconds','peak_rss_kib']}),flush=True)

if __name__=='__main__':main()
