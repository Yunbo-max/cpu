#!/usr/bin/env python3
from __future__ import annotations

import os
import resource
import subprocess
import sys

LIMIT = 4 * 1024**3
THREAD_VARS = {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "VECLIB_MAXIMUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1",
    "BLIS_NUM_THREADS": "1",
    "CUDA_VISIBLE_DEVICES": "",
}


def limit() -> None:
    resource.setrlimit(resource.RLIMIT_AS, (LIMIT, LIMIT))


def main() -> int:
    if len(sys.argv) < 2:
        raise SystemExit("usage: cpu_guard.py COMMAND [ARG ...]")
    env = os.environ.copy()
    env.update(THREAD_VARS)
    return subprocess.run(
        sys.argv[1:], env=env, preexec_fn=limit, check=False
    ).returncode


if __name__ == "__main__":
    raise SystemExit(main())
