#!/usr/bin/env python3
import json
import os
import resource
import time
from pathlib import Path

import numpy as np


DIM = 3_231_961
RANK = 16
BUFFER_WIDTH = 16
BUFFER_NNZ = 111
BLOCK_ROWS = 16_384
PROCESS_LIMIT = 4_294_967_296


def rss_bytes():
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024)


def buffer_add(block, lo, indices, values, small_rows):
    hi = lo + block.shape[0]
    for j in range(indices.shape[0]):
        idx = indices[j]
        mask = (idx >= lo) & (idx < hi)
        if np.any(mask):
            block[idx[mask] - lo] += values[j, mask, None] * small_rows[j]


def buffer_diag_add(diag, lo, indices, values):
    hi = lo + diag.size
    for j in range(indices.shape[0]):
        idx = indices[j]
        mask = (idx >= lo) & (idx < hi)
        if np.any(mask):
            np.add.at(diag, idx[mask] - lo, values[j, mask] ** 2)


def main():
    total_started = time.perf_counter()
    phase = {}

    init_started = time.perf_counter()
    d0 = np.empty(DIM, dtype=np.float64)
    dcur = np.empty(DIM, dtype=np.float64)
    l0 = np.empty((DIM, RANK), dtype=np.float64)
    lcur = np.empty((DIM, RANK), dtype=np.float64)
    cols = np.arange(RANK, dtype=np.float64)[None, :]
    for lo in range(0, DIM, BLOCK_ROWS):
        hi = min(DIM, lo + BLOCK_ROWS)
        rows_int = np.arange(lo, hi, dtype=np.int64)
        rows = rows_int.astype(np.float64)[:, None]
        base = ((((rows_int[:, None] * (np.arange(RANK, dtype=np.int64)[None, :] + 3)) + 17 * np.arange(RANK, dtype=np.int64)[None, :]) % 101) - 50).astype(np.float64) / 5000.0
        l0[lo:hi] = base
        lcur[lo:hi] = base * (0.985 + 0.0005 * cols) + 0.00002 * np.sin(rows * (cols + 1.0))
        d0[lo:hi] = 1.2 + (rows_int % 97) / 970.0
        dcur[lo:hi] = 1.1 + (rows_int % 89) / 890.0
    del cols

    buffer_indices = np.empty((BUFFER_WIDTH, BUFFER_NNZ), dtype=np.int64)
    buffer_values = np.empty((BUFFER_WIDTH, BUFFER_NNZ), dtype=np.float64)
    k = np.arange(BUFFER_NNZ, dtype=np.int64)
    for j in range(BUFFER_WIDTH):
        buffer_indices[j] = (j * 7_919 + k * 104_729 + 31) % DIM
        buffer_values[j] = (((k * (j + 5) + 13) % 29) - 14) / 50.0
    phase["initialization_seconds"] = time.perf_counter() - init_started
    rss_after_initialization = rss_bytes()

    gram_started = time.perf_counter()
    gram = np.zeros((RANK, RANK), dtype=np.float64)
    for lo in range(0, DIM, BLOCK_ROWS):
        hi = min(DIM, lo + BLOCK_ROWS)
        scaled = (1.0 / dcur[lo:hi])[:, None] * lcur[lo:hi]
        gram += lcur[lo:hi].T @ scaled
    phi = np.linalg.inv(np.eye(RANK) + gram)
    phase["gram_phi_seconds"] = time.perf_counter() - gram_started

    cross_started = time.perf_counter()
    cross_l = np.zeros((RANK, RANK), dtype=np.float64)
    for lo in range(0, DIM, BLOCK_ROWS):
        hi = min(DIM, lo + BLOCK_ROWS)
        ups = ((1.0 / dcur[lo:hi])[:, None] * lcur[lo:hi]) @ phi
        cross_l += l0[lo:hi].T @ ups
    cross_b = np.zeros((BUFFER_WIDTH, RANK), dtype=np.float64)
    for j in range(BUFFER_WIDTH):
        idx = buffer_indices[j]
        ups = ((1.0 / dcur[idx])[:, None] * lcur[idx]) @ phi
        cross_b[j] = np.sum(buffer_values[j, :, None] * ups, axis=0)
    phase["target_cross_seconds"] = time.perf_counter() - cross_started

    uts_started = time.perf_counter()
    uts = np.zeros((RANK, RANK), dtype=np.float64)
    for lo in range(0, DIM, BLOCK_ROWS):
        hi = min(DIM, lo + BLOCK_ROWS)
        ups = ((1.0 / dcur[lo:hi])[:, None] * lcur[lo:hi]) @ phi
        s = d0[lo:hi, None] * ups + l0[lo:hi] @ cross_l
        buffer_add(s, lo, buffer_indices, buffer_values, cross_b)
        uts += ups.T @ s
    hmat = phi + uts
    phase["uts_h_seconds"] = time.perf_counter() - uts_started

    update_started = time.perf_counter()
    factor_abs_change = 0.0
    diag_abs_change = 0.0
    output_diag_min = float("inf")
    output_diag_max = float("-inf")
    for lo in range(0, DIM, BLOCK_ROWS):
        hi = min(DIM, lo + BLOCK_ROWS)
        old_l = lcur[lo:hi]
        old_d = dcur[lo:hi]
        ups = ((1.0 / old_d)[:, None] * old_l) @ phi
        s = d0[lo:hi, None] * ups + l0[lo:hi] @ cross_l
        buffer_add(s, lo, buffer_indices, buffer_values, cross_b)
        lnext = np.linalg.solve(hmat.T, s.T).T
        dnext = d0[lo:hi] + np.sum(l0[lo:hi] * l0[lo:hi], axis=1)
        buffer_diag_add(dnext, lo, buffer_indices, buffer_values)
        dnext -= np.sum(lnext * s, axis=1)
        factor_abs_change += float(np.sum(np.abs(lnext - old_l)))
        diag_abs_change += float(np.sum(np.abs(dnext - old_d)))
        output_diag_min = min(output_diag_min, float(np.min(dnext)))
        output_diag_max = max(output_diag_max, float(np.max(dnext)))
        lcur[lo:hi] = lnext
        dcur[lo:hi] = dnext
    phase["output_update_seconds"] = time.perf_counter() - update_started
    iteration_seconds = sum(phase[name] for name in ["gram_phi_seconds", "target_cross_seconds", "uts_h_seconds", "output_update_seconds"])
    normalized_change = (factor_abs_change + diag_abs_change) / (DIM * (RANK + 1))

    owned_arrays = {
        "target_diagonal": d0.nbytes,
        "current_diagonal": dcur.nbytes,
        "target_factor": l0.nbytes,
        "current_factor": lcur.nbytes,
        "buffer_indices": buffer_indices.nbytes,
        "buffer_values": buffer_values.nbytes,
        "small_matrices": sum(a.nbytes for a in [gram, phi, cross_l, cross_b, uts, hmat]),
    }
    owned_array_bytes = int(sum(owned_arrays.values()))
    compressions_proxy = (6_017 - RANK) // BUFFER_WIDTH
    one_iteration_proxy_seconds = iteration_seconds * compressions_proxy

    result = {
        "schema_version": 1,
        "experiment": "url_fainv_block_em_calibration_v1",
        "scope": "One full-dimension deterministic block-EM iteration; no CW training or URL quality evaluation.",
        "dimension": DIM,
        "rank": RANK,
        "buffer_width": BUFFER_WIDTH,
        "buffer_nnz_per_column": BUFFER_NNZ,
        "block_rows": BLOCK_ROWS,
        "thread_env": {name: os.environ.get(name) for name in ["OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS"]},
        "phase_seconds": phase,
        "iteration_seconds_excluding_initialization": iteration_seconds,
        "normalized_parameter_change": normalized_change,
        "output_diagonal_min": output_diag_min,
        "output_diagonal_max": output_diag_max,
        "owned_arrays": owned_arrays,
        "owned_array_bytes": owned_array_bytes,
        "rss_after_initialization_bytes": rss_after_initialization,
        "process_peak_rss_bytes": rss_bytes(),
        "process_limit_bytes": PROCESS_LIMIT,
        "projection": {
            "accepted_updates_proxy_from_diag_cw": 6_017,
            "compressions_proxy_after_initial_factor_fill": compressions_proxy,
            "one_iteration_per_compression_seconds": one_iteration_proxy_seconds,
            "qualification": "Lower-bound diagnostic proxy only: true FAinv update count and EM iteration count are unknown; the released loop permits up to 50 iterations per compression.",
        },
        "gates": {
            "finite_positive_output_diagonal": bool(np.isfinite(output_diag_min) and np.isfinite(output_diag_max) and output_diag_min > 0.0),
            "owned_arrays_below_1_5_gib": owned_array_bytes < int(1.5 * 1024**3),
            "peak_rss_below_2_gib": rss_bytes() < 2 * 1024**3,
            "one_iteration_proxy_at_most_1800_seconds": one_iteration_proxy_seconds <= 1_800.0,
        },
        "total_wall_seconds": time.perf_counter() - total_started,
    }
    result["memory_gates_pass"] = result["gates"]["owned_arrays_below_1_5_gib"] and result["gates"]["peak_rss_below_2_gib"]
    result["retain_two_day_route"] = all(result["gates"].values())
    out = Path("results/url_fainv_block_em_calibration_v1.json")
    out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(result, sort_keys=True))
    if not result["gates"]["finite_positive_output_diagonal"]:
        raise SystemExit(2)


if __name__ == "__main__":
    main()
