#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import resource
import time
from pathlib import Path

LIMIT = 24


def t2(x: tuple[int, int, int]) -> tuple[int, int, int]:
    tau = sorted(x, reverse=True)[1]
    return tuple(max(v - tau, 0) for v in x)


def merge(x: tuple[int, int, int], y: tuple[int, int, int]) -> tuple[int, int, int]:
    return t2(tuple(u + v for u, v in zip(x, y)))


def selected_coordinate(x: tuple[int, int, int]) -> int:
    maximum = max(x)
    if maximum <= 0 or x.count(maximum) != 1:
        raise ValueError(f"no unique positive coordinate: {x}")
    return x.index(maximum)


def projection_cost(full: tuple[int, int, int], coordinate: int) -> int:
    return sum(full) - full[coordinate]


def main() -> None:
    started = time.perf_counter()
    eligible = reversal = equal_cost = 0
    mismatches: list[dict[str, object]] = []
    examples: dict[str, dict[str, object] | None] = {"reversal": None, "equal": None}
    minimum_margin = None
    canonical = hashlib.sha256()

    for a in range(1, LIMIT + 1):
        for b in range(1, LIMIT + 1):
            s = a + b
            for c in range(1, LIMIT + 1):
                if not c > s:
                    continue
                for d in range(1, LIMIT + 1):
                    if not d > c or d - c == s:
                        continue
                    eligible += 1
                    A, B = (a, 0, 0), (b, 0, 0)
                    C, D = (0, c, 0), (0, 0, d)
                    balanced = merge(merge(A, B), merge(C, D))
                    left = merge(merge(merge(A, B), C), D)
                    full = (s, c, d)
                    balanced_coord = selected_coordinate(balanced)
                    left_coord = selected_coordinate(left)
                    balanced_cost = projection_cost(full, balanced_coord)
                    left_cost = projection_cost(full, left_coord)
                    predicted_reversal = d - c < s
                    predicted_balanced_coord = 0 if predicted_reversal else 2
                    predicted_left_coord = 2
                    observed_reversal = balanced_cost > left_cost
                    if observed_reversal:
                        reversal += 1
                    else:
                        equal_cost += 1
                    margin = min(c - s, d - c, abs(s - (d - c)), d - (c - s))
                    minimum_margin = margin if minimum_margin is None else min(minimum_margin, margin)
                    record = {
                        "a": a,
                        "b": b,
                        "c": c,
                        "d": d,
                        "balanced": balanced,
                        "left": left,
                        "balanced_cost": balanced_cost,
                        "left_cost": left_cost,
                        "predicted_reversal": predicted_reversal,
                    }
                    canonical.update((json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode())
                    if examples["reversal" if predicted_reversal else "equal"] is None:
                        examples["reversal" if predicted_reversal else "equal"] = record
                    if (
                        balanced_coord != predicted_balanced_coord
                        or left_coord != predicted_left_coord
                        or observed_reversal != predicted_reversal
                        or (not predicted_reversal and balanced_cost != left_cost)
                        or (predicted_reversal and balanced_cost - left_cost != d - s)
                    ):
                        mismatches.append(record)

    result = {
        "schema_version": 1,
        "family": "A=a*e1,B=b*e1,C=c*e2,D=d*e3; d>c>a+b>0",
        "integer_limit_inclusive": LIMIT,
        "equality_surface_excluded": "d-c=a+b",
        "eligible_points": eligible,
        "predicted_and_observed_reversal_points": reversal,
        "predicted_and_observed_equal_cost_points": equal_cost,
        "mismatch_count": len(mismatches),
        "mismatches_first_10": mismatches[:10],
        "minimum_strict_margin": minimum_margin,
        "canonical_records_sha256": canonical.hexdigest(),
        "examples": examples,
        "elapsed_seconds": time.perf_counter() - started,
        "peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
        "scope": "Exact finite-grid verification of a restricted symbolic phase boundary; not a general FD guarantee.",
    }
    out = Path("results/fd_merge_orthogonal_phase_boundary_v1.json")
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(result, sort_keys=True))
    if mismatches:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
