#!/usr/bin/env python3
"""Audit center-kernel spectra on the released correlated-Gaussian workload."""
from __future__ import annotations

import json
import os
import resource
import sys
import time
from pathlib import Path

import numpy as np
from scipy.linalg import eigvalsh, svdvals
from scipy.spatial.distance import pdist


ROOT = Path(__file__).resolve().parents[1]
DEPS = ROOT / ".deps" / "nystrom_read"
sys.path.insert(0, str(ROOT / "compat"))
sys.path.insert(0, str(DEPS))

from kernels import RBFkernel  # noqa: E402
from nystrom import nys_inds  # noqa: E402
from samplers import generate_correlated_gaussians  # noqa: E402
from utils import median_pairwise, standardize_data  # noqa: E402


FLOOR = 1e-12
RHO2 = [0.51, 0.54, 0.57, 0.60, 0.63, 0.66, 0.69]
K_VALUES = [14, 28, 42, 56, 70, 140, 350, 500]
N_PER_GROUP = 2500
D = 3


def peak_rss_bytes() -> int:
    # Linux ru_maxrss is KiB.
    return int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) * 1024


def finite_float(x: float) -> float | None:
    return float(x) if np.isfinite(x) else None


def main() -> None:
    started = time.perf_counter()
    test_seeds = np.random.default_rng(20261012).integers(
        0, 2**32, size=8, dtype=np.uint32
    )
    tune_seeds = np.random.default_rng(20261013).integers(
        0, 2**32, size=len(RHO2), dtype=np.uint32
    )

    rows: list[dict[str, object]] = []
    for rho_index, rho2 in enumerate(RHO2):
        tune_seed = int(tune_seeds[rho_index])
        tune = generate_correlated_gaussians(
            500, D, rho1=0.5, rho2=rho2, seed=tune_seed
        )
        tune = standardize_data(tune)
        bandwidth = float(median_pairwise(tune))

        for test_index, test_seed_raw in enumerate(test_seeds):
            test_seed = int(test_seed_raw)
            z = generate_correlated_gaussians(
                N_PER_GROUP, D, rho1=0.5, rho2=rho2, seed=test_seed
            )
            z = standardize_data(z)

            for k in K_VALUES:
                inds, count = nys_inds(
                    z, k, method="uniform", sigma=bandwidth, seed=test_seed
                )
                landmarks = z[inds]
                km = RBFkernel(landmarks, landmarks, bandwidth)
                s = np.asarray(svdvals(km), dtype=np.float64)
                eig = np.asarray(eigvalsh(km), dtype=np.float64)

                default_rtol = np.finfo(np.float64).eps * max(km.shape)
                default_cutoff = default_rtol * float(s[0])
                abs_diff = float(np.max(np.abs(np.sort(s) - np.sort(np.abs(eig)))))
                scale = max(float(s[0]), np.finfo(np.float64).tiny)
                rows.append(
                    {
                        "rho2": rho2,
                        "rho_index": rho_index,
                        "test_index": test_index,
                        "test_seed": test_seed,
                        "tune_seed": tune_seed,
                        "n_per_group": N_PER_GROUP,
                        "d": D,
                        "k": k,
                        "landmark_count": int(count),
                        "bandwidth": bandwidth,
                        "s_max": float(s[0]),
                        "s_min": float(s[-1]),
                        "s_min_over_floor": float(s[-1] / FLOOR),
                        "condition_number": finite_float(float(s[0] / s[-1]))
                        if s[-1] > 0
                        else None,
                        "released_floor": FLOOR,
                        "count_below_released_floor": int(np.count_nonzero(s < FLOOR)),
                        "count_at_or_below_released_floor": int(np.count_nonzero(s <= FLOOR)),
                        "numpy_default_cutoff": default_cutoff,
                        "count_at_or_below_numpy_default_cutoff": int(
                            np.count_nonzero(s <= default_cutoff)
                        ),
                        "smallest_symmetric_eigenvalue": float(eig[0]),
                        "negative_eigenvalue_count": int(np.count_nonzero(eig < 0.0)),
                        "svd_abs_eigen_max_abs_diff": abs_diff,
                        "svd_eigen_relative_max_abs_diff": abs_diff / scale,
                        "minimum_landmark_distance": float(np.min(pdist(landmarks)))
                        if k > 1
                        else None,
                        "landmark_indices": [int(v) for v in inds],
                        "singular_values_descending": [float(v) for v in s],
                    }
                )

    below_rows = [r for r in rows if int(r["count_below_released_floor"]) > 0]
    max_count = max(int(r["count_below_released_floor"]) for r in rows)
    min_ratio = min(float(r["s_min_over_floor"]) for r in rows)
    summary = {
        "schema_version": 1,
        "question": "Do native correlated-Gaussian uniform-landmark center kernels cross the released 1e-12 singular-value floor?",
        "source_commit": "ddb9b2cacc092841518c3d4e18b745f266d8f517",
        "protocol": {
            "n_per_group": N_PER_GROUP,
            "d": D,
            "rho1": 0.5,
            "rho2": RHO2,
            "k_values": K_VALUES,
            "test_seeds": [int(v) for v in test_seeds],
            "tune_seeds": [int(v) for v in tune_seeds],
            "released_floor": FLOOR,
            "paper_seed_deviation": "Fixed prospective PCG64 seeds replace source seed=None and nondeterministic saved seed generation for reproducibility.",
        },
        "rows": len(rows),
        "rows_below_released_floor": len(below_rows),
        "fraction_rows_below_released_floor": len(below_rows) / len(rows),
        "maximum_count_below_released_floor": max_count,
        "minimum_s_min_over_floor": min_ratio,
        "floor_crossed": bool(below_rows),
        "svd_eigen_max_relative_disagreement": max(
            float(r["svd_eigen_relative_max_abs_diff"]) for r in rows
        ),
        "elapsed_seconds": time.perf_counter() - started,
        "peak_rss_bytes": peak_rss_bytes(),
        "thread_environment": {
            key: os.environ.get(key)
            for key in [
                "OMP_NUM_THREADS",
                "OPENBLAS_NUM_THREADS",
                "MKL_NUM_THREADS",
                "NUMEXPR_NUM_THREADS",
                "BLIS_NUM_THREADS",
                "CUDA_VISIBLE_DEVICES",
            ]
        },
        "scope_limit": "Finite prospective native-generator spectrum diagnostic; no null-size, power, frequency, or paper-validity inference.",
    }

    out_dir = ROOT / "results"
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "nystrom_native_spectrum_v1_rows.json").write_text(
        json.dumps(rows, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    (out_dir / "nystrom_native_spectrum_v1.json").write_text(
        json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    print(json.dumps(summary, sort_keys=True))


if __name__ == "__main__":
    main()
