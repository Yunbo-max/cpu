#!/usr/bin/env python3
"""Resolve, safely acquire, and inventory the source-linked FID-RTD repository."""

from __future__ import annotations

import hashlib
import json
import pathlib
import shutil
import tarfile
import urllib.request
from datetime import datetime, timezone


ROOT = pathlib.Path(__file__).resolve().parents[1]
DEPS = ROOT / ".deps" / "fid_rtd"
OUTPUT = ROOT / "sources" / "fid_rtd_source_manifest_v1.json"
API_URL = "https://api.github.com/repos/zys996/sample-optimal-fid-estimation/commits/main"
MAX_ARCHIVE_BYTES = 500_000_000


def sha256(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def request(url: str) -> urllib.request.Request:
    return urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "lowrank-coreset-streaming-source-audit/1.0",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )


def safe_destination(base: pathlib.Path, member_name: str) -> pathlib.Path:
    destination = (base / member_name).resolve()
    base_resolved = base.resolve()
    if destination != base_resolved and base_resolved not in destination.parents:
        raise RuntimeError(f"unsafe archive member: {member_name}")
    return destination


def main() -> None:
    DEPS.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(request(API_URL), timeout=60) as response:
        metadata = json.load(response)
    commit = metadata["sha"]
    if len(commit) != 40 or any(c not in "0123456789abcdef" for c in commit):
        raise RuntimeError(f"unexpected commit identity: {commit!r}")

    archive_url = f"https://codeload.github.com/zys996/sample-optimal-fid-estimation/tar.gz/{commit}"
    archive = DEPS / f"sample-optimal-fid-estimation-{commit}.tar.gz"
    if not archive.exists():
        with urllib.request.urlopen(request(archive_url), timeout=120) as response, archive.open("wb") as handle:
            total = 0
            while True:
                chunk = response.read(1024 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_ARCHIVE_BYTES:
                    raise RuntimeError("archive exceeds 500,000,000-byte acquisition cap")
                handle.write(chunk)

    extracted = DEPS / f"repo-{commit}"
    if extracted.exists():
        shutil.rmtree(extracted)
    extracted.mkdir(parents=True)
    with tarfile.open(archive, "r:gz") as bundle:
        members = bundle.getmembers()
        for member in members:
            safe_destination(extracted, member.name)
            if member.issym() or member.islnk() or member.isdev():
                raise RuntimeError(f"unsupported archive member type: {member.name}")
        bundle.extractall(extracted, members=members, filter="data")

    roots = [p for p in extracted.iterdir() if p.is_dir()]
    if len(roots) != 1:
        raise RuntimeError(f"expected one repository root, found {len(roots)}")
    repo = roots[0]
    files = []
    for path in sorted(p for p in repo.rglob("*") if p.is_file()):
        files.append(
            {
                "path": path.relative_to(repo).as_posix(),
                "size_bytes": path.stat().st_size,
                "sha256": sha256(path),
            }
        )

    required = [
        "README.md",
        "pyproject.toml",
        "requirements-report.txt",
        "configs/examples/gaussian.yaml",
    ]
    required_dirs = ["src/gaussian_w2/estimators", "experiments/gaussian"]
    checks = {
        **{path: (repo / path).is_file() for path in required},
        **{path: (repo / path).is_dir() for path in required_dirs},
    }
    result = {
        "schema_version": 1,
        "created_at_utc": datetime.now(timezone.utc).isoformat(),
        "repository": "https://github.com/zys996/sample-optimal-fid-estimation",
        "api_url": API_URL,
        "resolved_commit": commit,
        "commit_html_url": metadata.get("html_url"),
        "commit_date": metadata.get("commit", {}).get("committer", {}).get("date"),
        "archive_url": archive_url,
        "archive_size_bytes": archive.stat().st_size,
        "archive_sha256": sha256(archive),
        "file_count": len(files),
        "total_extracted_file_bytes": sum(item["size_bytes"] for item in files),
        "required_path_checks": checks,
        "all_required_paths_present": all(checks.values()),
        "top_level_entries": sorted(path.name for path in repo.iterdir()),
        "files": files,
        "archive_local_path": str(archive),
        "repository_local_path": str(repo),
        "recoverability": "external source; .deps excluded from checkpoint",
        "executed_repository_code": False,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
    print(json.dumps({k: v for k, v in result.items() if k != "files"}, sort_keys=True))


if __name__ == "__main__":
    main()
